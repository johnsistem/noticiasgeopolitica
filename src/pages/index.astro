---
import TopNavLayout from '../layouts/TopNavLayout.astro';
import { getCollection } from 'astro:content';
import { theaters } from '../data/theaters.js';

// Obtener y ordenar los cables por fecha (más reciente primero)
const allCables = await getCollection('cables');
const allInformes = await getCollection('informes');
const sortedCables = allCables.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// El cable más reciente será la noticia principal
const leadCable = sortedCables[0];
// El informe más reciente (para el dossier destacado)
const sortedInformes = [...allInformes].sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
const featuredInforme = sortedInformes[0];
// Todos los cables secundarios
const secondaryCables = sortedCables.slice(1);
const totalSecondary = secondaryCables.length;

// Métricas reales desde el contenido
const totalCables = allCables.length;
const totalInformes = allInformes.length;
const totalDefconCritical = allCables.filter(c => c.data.threat_level === 'Crítica').length;
const totalRegionMarRojo = allCables.filter(c => c.data.region === 'Mar Rojo').length;
const totalTeatros = theaters.length;
const teatrosCriticos = theaters.filter(t => t.threat === 'Crítica').length;

// Supabase Newsletter simulation logic
let message = '';
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const email = data.get('email');
    // Simulated delay and success response
    await new Promise(resolve => setTimeout(resolve, 500));
    console.log(`Subscribed: ${email}`);
    message = 'ENLACE REGISTRADO CON ÉXITO: Recibirás confirmación encriptada en los próximos 2 minutos.';
  } catch (error) {
    if (error instanceof Error) {
      console.error(error.message);
    }
  }
}
