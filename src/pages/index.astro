<script is:inline>
  function initHomeTacticalMap() {
    if (typeof L === 'undefined' || !document.getElementById('homeTacticalMap')) {
      setTimeout(initHomeTacticalMap, 200);
      return;
    }
    const map = L.map('homeTacticalMap', {
      center: [12.6534, 43.4182],
      zoom: 9,
      zoomControl: false,
      attributionControl: false,
      scrollWheelZoom: false
    });

    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 16
    }).addTo(map);

    const center = L.latLng(12.6534, 43.4182);

    // ---- CAPA 1: RUTAS AIS (corredores de navegación) ----
    const aisLayer = L.layerGroup().addTo(map);
    const lanes = [
      [[13.20, 43.05], [12.65, 43.42], [12.10, 43.75]],
      [[13.45, 42.95], [12.90, 43.30], [12.30, 43.95]]
    ];
    lanes.forEach((pts, idx) => {
      L.polyline(pts, {
        color: idx === 0 ? '#10b981' : '#38bdf8',
        weight: 2,
        opacity: 0.8,
        dashArray: idx === 0 ? null : '6 8'
      }).addTo(aisLayer);
    });

    // ---- CAPA 2: ALCANCE DE MISILES (cobertura A2/AD) ----
    const missileLayer = L.layerGroup();
    L.circle([12.6534, 43.4182], { radius: 300000, color: '#ef4444', weight: 1.5, dashArray: '5 6', fill: true, fillColor: '#ef4444', fillOpacity: 0.06, opacity: 0.5 })
      .bindPopup('<div style="color:#ef4444;font-family:monospace;font-weight:bold;font-size:12px;">ALCANCE TEÓRICO ~300 km</div><div style="color:#9ca3af;font-family:monospace;font-size:11px;">Cobertura estimada (Al-Mandab 2)</div>')
      .addTo(missileLayer);
    L.circle([13.60, 43.30], { radius: 120000, color: '#f59e0b', weight: 1.5, dashArray: '4 5', fill: true, fillColor: '#f59e0b', fillOpacity: 0.05, opacity: 0.5 })
      .bindPopup('<div style="color:#f59e0b;font-family:monospace;font-weight:bold;font-size:12px;">ALCANCE TEÓRICO ~120 km</div><div style="color:#9ca3af;font-family:monospace;font-size:11px;">Cobertura estimada (Noor / C-802)</div>')
      .addTo(missileLayer);

    // ---- CAPA 3: BASES NAVALES ----
    const basesLayer = L.layerGroup();
    const baseIcon = L.divIcon({
      className: 'base-marker',
      html: '<div style="width:14px;height:14px;border-radius:3px;background:#38bdf8;border:2px solid #fff;box-shadow:0 0 10px rgba(56,189,248,.8);transform:rotate(45deg);"></div>',
      iconSize: [14, 14],
      iconAnchor: [7, 7]
    });
    const bases = [
      { lat: 11.54, lon: 43.15, name: 'CAMP LEMONNIER (EE. UU.)' },
      { lat: 11.60, lon: 43.10, name: 'BASE DORALEH (CHINA)' },
      { lat: 13.01, lon: 42.73, name: 'PUERTO DE ASSAB (ERITREA)' }
    ];
    bases.forEach(b => {
      L.marker([b.lat, b.lon], { icon: baseIcon }).addTo(basesLayer)
        .bindPopup('<div style="color:#38bdf8;font-family:monospace;font-weight:bold;font-size:12px;">' + b.name + '</div>');
    });

    // ---- CAPA 4: PETROLEROS VLCC ----
    const vlccLayer = L.layerGroup();
    const vlccIcon = L.divIcon({
      className: 'vlcc-marker',
      html: '<div style="width:16px;height:16px;border-radius:9999px;background:#f59e0b;border:2px solid #fff;box-shadow:0 0 10px rgba(245,158,11,.9);display:flex;align-items:center;justify-content:center;font-size:9px;">▲</div>',
      iconSize: [16, 16],
      iconAnchor: [8, 8]
    });
    const vlccs = [
      { lat: 12.821, lon: 43.284 },
      { lat: 12.905, lon: 43.180 },
      { lat: 12.760, lon: 43.520 }
    ];
    vlccs.forEach(v => {
      L.marker([v.lat, v.lon], { icon: vlccIcon }).addTo(vlccLayer)
        .bindPopup('<div style="color:#f59e0b;font-family:monospace;font-weight:bold;font-size:12px;">PETROLERO VLCC (EST.)</div><div style="color:#9ca3af;font-family:monospace;font-size:11px;">Posición estimada · ' + v.lat.toFixed(3) + '° N, ' + v.lon.toFixed(3) + '° E</div>');
    });

    const pulse = L.divIcon({
      className: 'home-pulse-marker',
      html: '<div style="position:relative;width:32px;height:32px;display:flex;align-items:center;justify-content:center;"><span class="animate-ping absolute inline-flex h-full w-full rounded-full" style="background:#ef4444;opacity:.75;"></span><span style="position:relative;display:inline-flex;width:14px;height:14px;border-radius:9999px;background:#ef4444;border:2px solid #fff;box-shadow:0 0 12px rgba(239,68,68,.8);"></span></div>',
      iconSize: [32, 32],
      iconAnchor: [16, 16]
    });

    const positions = [
      { lat: 12.6534, lon: 43.4182, name: 'ISLA DE PERIM (MAYYUN)', desc: 'Batería de Misiles & Pista Táctica' },
      { lat: 12.7821, lon: 43.5109, name: 'PUESTO DE RADAR COSTERO', desc: 'Vigilancia marítima y AShM' },
      { lat: 12.6102, lon: 43.3411, name: 'BAB ISKANDER (CANAL)', desc: 'Ancho 2.9 Nmi' }
    ];

    positions.forEach(p => {
      L.marker([p.lat, p.lon], { icon: pulse }).addTo(map)
        .bindPopup('<div style="color:#10b981;font-family:monospace;font-weight:bold;font-size:12px;">' + p.name + '</div><div style="color:#9ca3af;font-family:monospace;font-size:11px;">' + p.desc + '</div>');
    });

    // ---- CONTROL DE CAPAS (botones) ----
    const layerConfig = [
      { id: 'layerToggleAIS', layer: aisLayer, active: true },
      { id: 'layerToggleMissiles', layer: missileLayer, active: false },
      { id: 'layerToggleBases', layer: basesLayer, active: false },
      { id: 'layerToggleVLCC', layer: vlccLayer, active: false }
    ];

    layerConfig.forEach(cfg => {
      const btn = document.getElementById(cfg.id);
      if (!btn) return;
      const setState = (on) => {
        if (on) { cfg.layer.addTo(map); } else { map.removeLayer(cfg.layer); }
        btn.dataset.active = on ? 'true' : 'false';
        if (on) {
          btn.className = 'layer-toggle bg-primary text-on-primary font-label-sm text-label-sm px-2.5 py-1 rounded font-bold flex items-center gap-1 transition-colors';
          if (!btn.querySelector('.material-symbols-outlined')) {
            const icon = document.createElement('span');
            icon.className = 'material-symbols-outlined text-[14px]';
            icon.textContent = 'check';
            btn.prepend(icon);
          }
        } else {
          btn.className = 'layer-toggle bg-surface-container hover:bg-surface-container-high text-on-surface font-label-sm text-label-sm px-2.5 py-1 rounded transition-colors';
          btn.querySelector('.material-symbols-outlined')?.remove();
        }
      };
      setState(cfg.active);
      btn.addEventListener('click', () => setState(btn.dataset.active !== 'true'));
    });

    document.getElementById('homeMapZoomIn')?.addEventListener('click', () => map.zoomIn());
    document.getElementById('homeMapZoomOut')?.addEventListener('click', () => map.zoomOut());
  }
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initHomeTacticalMap();
  } else {
    document.addEventListener('DOMContentLoaded', initHomeTacticalMap);
  }
</script>
