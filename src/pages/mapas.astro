<!-- Interactive Coordinate Tracker & Pin Focus Script -->
<script is:inline>
    const mapContainer = document.getElementById('tacticalMapContainer');
    const coordDisplay = document.getElementById('coordDisplay');

    if (mapContainer && coordDisplay) {
      mapContainer.addEventListener('mousemove', (e) => {
        const rect = mapContainer.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        // Approximate calculation to project lat/lon in Bab el-Mandeb bounds
        const lat = (12.9 - (y / rect.height) * 0.6).toFixed(4);
        const lon = (43.1 + (x / rect.width) * 0.7).toFixed(4);
        coordDisplay.textContent = `${lat}°N ${lon}°E`;
      });
    }

    function focusPin(pinId) {
      const coords = {
        'perim': '12.6534°N 43.4182°E',
        'radar': '12.7821°N 43.5109°E',
        'canal': '12.6102°N 43.3411°E',
        'tankers': '12.8210°N 43.2840°E'
      };

      if (coordDisplay && coords[pinId]) {
        coordDisplay.textContent = coords[pinId];
        coordDisplay.classList.add('text-secondary');
        setTimeout(() => coordDisplay.classList.remove('text-secondary'), 800);
      }
    }
  </script>
