---
import SidebarLayout from '../layouts/SidebarLayout.astro';
import { theaters } from '../data/theaters.js';

const active = theaters[0];
const catalog = theaters.slice(1);
---

<SidebarLayout
  title="Mapas de Conflicto en Tiempo Real"
  description="Visualizadores dinámicos en capas con vectores de choque, flujos logísticos globales, alcances de sistemas antiaéreos y rutas comerciales estratégicas en teatros de conflicto activos."
  image="/og-default.jpg"
>
<div class="flex flex-col w-full">
<script type="application/json" id="theatersData" set:html={JSON.stringify(theaters)}></script>
<!-- Top Telemetry Micro-Bar -->
<div class="flex items-center justify-between py-space-xs mb-space-sm font-label-sm text-label-sm text-outline">
<div class="flex items-center gap-space-sm">
<span class="inline-flex items-center gap-1 bg-surface-container-high px-2 py-0.5 rounded text-primary">
<span class="w-1.5 h-1.5 rounded-full bg-primary animate-ping"></span>
        MAPA ACTUALIZADO
      </span>
<span class="text-outline-variant">/</span>
<span>IMÁGENES SATÉLITE DE REFERENCIA</span>
<span class="text-outline-variant">/</span>
<span class="text-on-surface-variant">RESOLUCIÓN SATELITAL COMERCIAL</span>
</div>
<div class="flex items-center gap-space-md">
<span class="text-secondary font-mono">LAT 12.6534° N // LON 43.4182° E</span>
<span class="bg-surface-container px-2 py-0.5 rounded text-tertiary">DATUM WGS-84</span>
</div>
</div>
<!-- 1. ENCABEZADO DE SECCIÓN GEOESPACIAL -->
<section class="mb-space-lg">
<div class="bg-surface-container-low p-space-lg rounded-lg shadow-xl relative overflow-hidden">
<!-- Reticle Ambient Decoration -->
<div class="absolute -right-8 -top-8 w-48 h-48 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>
<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-md relative z-10 mb-space-md">
<div>
<div class="flex items-center gap-2 text-primary font-label-sm text-label-sm mb-1 uppercase tracking-widest">
<span class="material-symbols-outlined text-[16px]">satellite_alt</span>
<span>Módulo de Reconocimiento Estratégico Multiespectral</span>
</div>
<h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface tracking-tight uppercase">
            Mapas de Zonas de Conflicto
          </h1>
<p class="font-body-md text-body-md text-on-surface-variant max-w-4xl mt-1">
            Explora interactivamente fronteras en disputa, rutas marítimas estratégicas, puntos de estrangulamiento y análisis geopolítico basado en fuentes abiertas.
          </p>
</div>

</div>
<!-- Filters & Control Strip -->
<div class="pt-space-md bg-surface-container/60 p-space-sm rounded flex flex-col xl:flex-row gap-space-md items-start xl:items-center justify-between">
<!-- Region Filter Pills -->
<div class="flex flex-wrap items-center gap-1.5">
<span class="font-label-sm text-label-sm text-outline mr-2 uppercase flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">public</span> Región:
          </span>
<button data-region="todas" class="region-btn bg-primary text-on-primary font-label-sm text-label-sm px-2.5 py-1 rounded font-bold uppercase transition hover:brightness-110">
            Todas
          </button>
<button data-region="hormuz" class="region-btn bg-surface-container-high text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm px-2.5 py-1 rounded uppercase transition">
            Oriente Medio
          </button>
<button data-region="bab-el-mandeb" class="region-btn region-active bg-surface-container-high text-primary font-label-sm text-label-sm px-2.5 py-1 rounded uppercase transition ring-0 shadow-sm flex items-center gap-1">
<span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span> Mar Rojo
          </button>
<button data-region="taiwan" class="region-btn bg-surface-container-high text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm px-2.5 py-1 rounded uppercase transition">
            Taiwán
          </button>
<button data-region="artico" class="region-btn bg-surface-container-high text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm px-2.5 py-1 rounded uppercase transition">
            Ártico
          </button>
<button data-region="nilo" class="region-btn bg-surface-container-high text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm px-2.5 py-1 rounded uppercase transition">
            Cuerno de África
          </button>
</div>
<!-- Threat & Display Modes -->
<div class="flex flex-wrap items-center gap-space-md">
<!-- Threat Mode Select -->
<div class="flex items-center gap-1.5">
<span class="font-label-sm text-label-sm text-outline uppercase flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">shield_with_heart</span> Amenaza:
            </span>
<div class="flex bg-surface-container-highest rounded p-0.5">
<button data-threat="naval" class="threat-btn bg-primary-container text-on-primary-container font-label-sm text-label-sm px-2 py-0.5 rounded font-bold uppercase">Naval</button>
<button data-threat="terrestre" class="threat-btn text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm px-2 py-0.5 rounded uppercase">Terrestre</button>
<button data-threat="energia" class="threat-btn text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm px-2 py-0.5 rounded uppercase">Energía</button>
<button data-threat="ciber" class="threat-btn text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm px-2 py-0.5 rounded uppercase">Ciber/Sat</button>
</div>
</div>
<!-- Map Surface Select -->
<div class="flex items-center gap-1.5">
<span class="font-label-sm text-label-sm text-outline uppercase flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">layers</span> Modo:
            </span>
<div class="flex bg-surface-container-highest rounded p-0.5">
<button data-mode="satelital" class="mode-btn text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm px-2 py-0.5 rounded uppercase">Satelital</button>
<button data-mode="vector" class="mode-btn mode-active bg-secondary text-on-secondary font-label-sm text-label-sm px-2 py-0.5 rounded font-bold uppercase">Vector Táctico</button>
<button data-mode="comercial" class="mode-btn text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm px-2 py-0.5 rounded uppercase">Comercial</button>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- 2. ÁREA DE TRABAJO PRINCIPAL DUAL (Mapa Interactivo 60% + Panel de Lectura 40%) -->
<section class="grid grid-cols-1 lg:grid-cols-12 gap-space-md mb-space-xl">
<!-- Lado Izquierdo: Visor de Mapa Táctico Interactivo (7 cols ~ 58-60%) -->
<div class="lg:col-span-7 flex flex-col bg-surface-container-lowest rounded-lg overflow-hidden shadow-2xl relative">
<!-- Top HUD Header over Map -->
<div class="bg-surface-container-low px-space-md py-space-xs flex items-center justify-between z-20">
<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-primary text-[18px]">file_download_done</span>
<span id="visorTitle" class="font-label-md text-label-md text-on-surface uppercase font-bold tracking-wider">BAB EL-MANDEB &amp; ISLA DE PERIM</span>
</div>
<div class="flex items-center gap-space-sm font-label-sm text-label-sm">
<span class="text-primary animate-pulse">● MAPA ACTIVO</span>
<span class="text-outline">|</span>
<span class="text-on-surface-variant">ESCALA: 1:75,000</span>
</div>
</div>
<!-- Canvas Area / Map Container -->
<div class="relative w-full h-[620px] bg-[#0b0e14] overflow-hidden select-none" id="tacticalMapContainer">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<!-- Mapa Leaflet real -->
<div id="visorTacticalMap" class="absolute inset-0 z-0"></div>

<!-- Aviso: capas ilustrativas -->
<div class="absolute top-3 right-3 z-30 flex items-center gap-1.5 bg-surface-container-lowest/90 backdrop-blur-md border border-tertiary/40 px-2.5 py-1 rounded shadow-lg pointer-events-none">
<span class="material-symbols-outlined text-tertiary text-[14px]">info</span>
<span class="font-label-sm text-label-sm text-tertiary font-bold uppercase tracking-wider">CAPAS ILUSTRATIVAS · NO SON DATOS EN VIVO</span>
</div>

<!-- Floating Tactical Layer Controller Widget -->
<div class="absolute top-4 left-4 z-20 bg-surface-container-low/90 backdrop-blur-md p-space-sm rounded shadow-2xl w-60">
<div class="flex items-center justify-between pb-1 mb-2 font-label-sm text-label-sm text-on-surface uppercase font-bold">
<span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[15px] text-primary">tune</span> Capas Activas</span>
</div>
<div class="flex flex-col gap-1.5 font-label-sm text-label-sm">
<label class="flex items-center justify-between cursor-pointer py-0.5 px-1 hover:bg-surface-container rounded">
<span class="text-on-surface-variant">Puntos Clave / Perim</span>
<input checked="" class="accent-primary rounded cursor-pointer" type="checkbox" id="visorChkPerim"/>
</label>
<label class="flex items-center justify-between cursor-pointer py-0.5 px-1 hover:bg-surface-container rounded">
<span class="text-on-surface-variant">Rutas Marítimas (Est.)</span>
<input checked="" class="accent-primary rounded cursor-pointer" type="checkbox" id="visorChkRutas"/>
</label>
<label class="flex items-center justify-between cursor-pointer py-0.5 px-1 hover:bg-surface-container rounded">
<span class="text-on-surface-variant">Zona de exclusión (estimada)</span>
<input class="accent-primary rounded cursor-pointer" type="checkbox" id="visorChkMissile"/>
</label>
</div>
</div>
<!-- Floating Dynamic Scale & Coordinates Indicator (Bottom Bar) -->
<div class="absolute bottom-3 left-3 right-3 z-20 flex items-center justify-between bg-surface-container-low/85 backdrop-blur px-space-md py-1.5 rounded">
<div class="flex items-center gap-space-md font-label-sm text-label-sm">
<div class="flex items-center gap-1 text-on-surface">
<span class="text-outline">COORDENADAS:</span>
<span class="text-primary font-mono font-bold" id="coordDisplay">12.6534°N 43.4182°E</span>
</div>
<div class="text-outline font-mono">VISTA GLOBAL</div>
</div>
<!-- Nautical Scale Widget -->
<div class="flex items-center gap-2 font-label-sm text-label-sm text-outline">
<span>0</span>
<div class="w-16 h-1 bg-surface-bright flex">
<div class="w-1/2 h-full bg-primary"></div>
<div class="w-1/2 h-full bg-on-surface"></div>
</div>
<span>10 NM (18.5 KM)</span>
</div>
</div>

<script is:inline>
(function () {
  const theaters = JSON.parse(document.getElementById('theatersData').textContent);
  let visorMap = null;
  let baseLayer = null;
  let gPoints = null, gRoutes = null, gZones = null;
  let currentTheaterId = null;

  function updatePanel(t) {
    const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
    set('intelTitle', t.name);
    set('intelRegion', 'SEC: ' + t.region.toUpperCase());
    set('intelThreat', 'AMENAZA ' + t.threat.toUpperCase());
    set('intelSource', t.source);
    set('intelSummary', t.summary);

    const box = document.getElementById('intelPoints');
    if (box) {
      box.innerHTML = t.analysis.map((p, i) =>
        '<div class="bg-surface-container p-space-sm rounded transition hover:bg-surface-container-high">' +
          '<div class="flex items-center justify-between mb-1">' +
            '<span class="font-label-sm text-label-sm text-primary font-bold uppercase">' + p.title + '</span>' +
            '<button class="text-outline hover:text-primary font-label-sm text-label-sm flex items-center gap-1" data-focus-index="' + i + '">' +
              '<span class="material-symbols-outlined text-[14px]">my_location</span> Enfocar' +
            '</button>' +
          '</div>' +
          '<p class="font-body-sm text-body-sm text-on-surface-variant">' + p.text + '</p>' +
        '</div>'
      ).join('');
    }
  }

  function drawTheater(t) {
    gPoints.clearLayers(); gRoutes.clearLayers(); gZones.clearLayers();

    const pulse = L.divIcon({
      className: 'visor-pulse',
      html: '<div style="position:relative;width:30px;height:30px;display:flex;align-items:center;justify-content:center;"><span class="animate-ping absolute inline-flex h-full w-full rounded-full" style="background:#ef4444;opacity:.75;"></span><span style="position:relative;display:inline-flex;width:13px;height:13px;border-radius:9999px;background:#ef4444;border:2px solid #fff;"></span></div>',
      iconSize: [30, 30], iconAnchor: [15, 15]
    });
    const square = L.divIcon({
      className: 'visor-square',
      html: '<div style="width:14px;height:14px;border-radius:3px;background:#38bdf8;border:2px solid #fff;transform:rotate(45deg);"></div>',
      iconSize: [14, 14], iconAnchor: [7, 7]
    });

    t.keyPoints.forEach(p => {
      L.marker([p.lat, p.lon], { icon: pulse }).addTo(gPoints)
        .bindPopup('<div style="color:#10b981;font-family:monospace;font-weight:bold;font-size:12px;">' + p.name + '</div><div style="color:#9ca3af;font-family:monospace;font-size:11px;">' + p.desc + '</div>');
    });
    t.bases.forEach(b => {
      L.marker([b.lat, b.lon], { icon: square }).addTo(gPoints)
        .bindPopup('<div style="color:#38bdf8;font-family:monospace;font-weight:bold;font-size:12px;">' + b.name + '</div>');
    });
    t.routes.forEach((pts, idx) => {
      L.polyline(pts, { color: idx === 0 ? '#10b981' : '#38bdf8', weight: 2, opacity: 0.8, dashArray: idx === 0 ? null : '6 8' }).addTo(gRoutes);
    });
    t.zones.forEach(z => {
      L.circle([z.lat, z.lon], { radius: z.radius, color: z.color || '#ef4444', weight: 1.5, dashArray: '5 6', fill: true, fillColor: z.color || '#ef4444', fillOpacity: 0.06, opacity: 0.5 })
        .bindPopup('<div style="color:' + (z.color || '#ef4444') + ';font-family:monospace;font-weight:bold;font-size:12px;">' + z.name + '</div>').addTo(gZones);
    });

    const visorTitle = document.getElementById('visorTitle');
    if (visorTitle) visorTitle.textContent = t.name;
  }

  function applyLayerToggles() {
    const set = (id, group) => {
      const el = document.getElementById(id);
      if (!el) return;
      if (el.checked) { group.addTo(visorMap); } else { visorMap.removeLayer(group); }
    };
    set('visorChkPerim', gPoints);
    set('visorChkRutas', gRoutes);
    set('visorChkMissile', gZones);
  }

  function setActiveRegion(id) {
    document.querySelectorAll('.region-btn').forEach(b => {
      if (b.getAttribute('data-region') === id) {
        b.classList.add('region-active', 'text-primary');
        b.classList.remove('text-on-surface-variant');
        if (b.getAttribute('data-region') && b.getAttribute('data-region') !== 'todas') {
          // asegura el indicador pulsante en la píldora correspondiente
          if (!b.querySelector('.bullet')) {
            const dot = document.createElement('span');
            dot.className = 'bullet w-1.5 h-1.5 rounded-full bg-primary animate-pulse mr-1';
            b.prepend(dot);
          }
        }
      } else {
        b.classList.remove('region-active', 'text-primary');
        b.classList.add('text-on-surface-variant');
        b.querySelector('.bullet')?.remove();
      }
    });
  }

  window.loadTheater = function (id) {
    const t = theaters.find(x => x.id === id);
    if (!t) return;
    if (!visorMap || !gPoints || !gRoutes || !gZones) {
      setTimeout(() => window.loadTheater(id), 250);
      return;
    }
    currentTheaterId = id;
    drawTheater(t);
    applyLayerToggles();
    visorMap.flyTo(t.center, t.zoom, { duration: 1.0 });
    updatePanel(t);
    const coordDisplay = document.getElementById('coordDisplay');
    if (coordDisplay) coordDisplay.textContent = t.center[0].toFixed(4) + '°N ' + t.center[1].toFixed(4) + '°E';
    document.getElementById('visorTacticalMap')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    if (typeof setActiveRegion === 'function') setActiveRegion(id);
    if (window.location.hash.replace('#', '') !== id) {
      try { history.replaceState(null, '', '#' + id); } catch (e) {}
    }
  };

  function initVisorMap() {
    if (typeof L === 'undefined' || !document.getElementById('visorTacticalMap')) {
      setTimeout(initVisorMap, 200);
      return;
    }
    const t0 = theaters[0];
    visorMap = L.map('visorTacticalMap', {
      center: t0.center,
      zoom: t0.zoom,
      zoomControl: false,
      attributionControl: false,
      scrollWheelZoom: true
    });

    baseLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 16
    }).addTo(visorMap);

    // Cambiar capa base según el modo seleccionado
    window.switchMode = function (mode) {
      if (!visorMap) return;
      const urls = {
        vector: 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}',
        satelital: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
        comercial: 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png'
      };
      if (!urls[mode]) return;
      if (baseLayer) visorMap.removeLayer(baseLayer);
      baseLayer = L.tileLayer(urls[mode], { maxZoom: 16 }).addTo(visorMap);
    };

    gPoints = L.layerGroup().addTo(visorMap);
    gRoutes = L.layerGroup().addTo(visorMap);
    gZones = L.layerGroup();

    drawTheater(t0);
    currentTheaterId = t0.id;
    applyLayerToggles();

    ['visorChkPerim', 'visorChkRutas', 'visorChkMissile'].forEach(id => {
      document.getElementById(id)?.addEventListener('change', applyLayerToggles);
    });

    const coordDisplay = document.getElementById('coordDisplay');
    visorMap.on('mousemove', (e) => {
      if (coordDisplay) coordDisplay.textContent = e.latlng.lat.toFixed(4) + '°N ' + e.latlng.lng.toFixed(4) + '°E';
    });

    // Enfocar puntos desde el panel
    document.getElementById('intelPoints')?.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-focus-index]');
      if (!btn || !visorMap) return;
      const t = theaters.find(x => x.id === currentTheaterId);
      const idx = parseInt(btn.dataset.focusIndex, 10);
      const kp = t && t.keyPoints[idx % Math.max(t.keyPoints.length, 1)];
      if (kp) visorMap.flyTo([kp.lat, kp.lon], 10, { duration: 0.8 });
    });

    document.getElementById('visorZoomIn')?.addEventListener('click', () => visorMap.zoomIn());
    document.getElementById('visorZoomOut')?.addEventListener('click', () => visorMap.zoomOut());
    document.getElementById('visorRecenter')?.addEventListener('click', () => {
      const t = theaters.find(x => x.id === currentTheaterId) || t0;
      visorMap.flyTo(t.center, t.zoom, { duration: 0.8 });
    });

    // Filtro por REGIÓN
    document.querySelectorAll('.region-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const region = btn.getAttribute('data-region');
        if (region && region !== 'todas') {
          if (typeof window.loadTheater === 'function') window.loadTheater(region);
        } else {
          if (typeof window.loadTheater === 'function') window.loadTheater(theaters[0].id);
        }
      });
    });

    // Selector de MODO (capa base)
    document.querySelectorAll('.mode-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode');
        if (typeof window.switchMode === 'function') window.switchMode(mode);
        document.querySelectorAll('.mode-btn').forEach(b => {
          b.classList.remove('mode-active', 'bg-secondary', 'text-on-secondary', 'font-bold');
          b.classList.add('text-on-surface-variant', 'hover:text-on-surface');
        });
        btn.classList.add('mode-active', 'bg-secondary', 'text-on-secondary', 'font-bold');
        btn.classList.remove('text-on-surface-variant', 'hover:text-on-surface');
      });
    });

    // Selector de AMENAZA (visual, tipo de vector destacado)
    document.querySelectorAll('.threat-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.threat-btn').forEach(b => {
          b.classList.remove('bg-primary-container', 'text-on-primary-container', 'font-bold');
          b.classList.add('text-on-surface-variant', 'hover:text-on-surface');
        });
        btn.classList.add('bg-primary-container', 'text-on-primary-container', 'font-bold');
        btn.classList.remove('text-on-surface-variant', 'hover:text-on-surface');
      });
    });

    // Cargar teatro vía hash (#hormuz, #spratly, ...) desde links del sidebar
    const applyHash = () => {
      const h = window.location.hash.replace('#', '');
      if (h && theaters.some(t => t.id === h)) {
        if (typeof window.loadTheater === 'function') window.loadTheater(h);
      }
    };
    window.addEventListener('hashchange', applyHash);
    setTimeout(applyHash, 600);
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initVisorMap();
  } else {
    document.addEventListener('DOMContentLoaded', initVisorMap);
  }
})();
</script>
</div>
<!-- Map Footer Controls: Zoom, Reset, Satellite Layer Switcher -->
<div class="bg-surface-container-low px-space-md py-2 flex items-center justify-between z-20">
<div class="flex items-center gap-1 font-label-sm text-label-sm text-on-surface-variant">
<span class="material-symbols-outlined text-[16px] text-tertiary">warning</span>
<span>ZONA DE RIESGO DE GUERRA: CONDICIÓN JWC ALTA (LLOYD'S 2024)</span>
</div>
<div class="flex items-center gap-1">
<button id="visorZoomIn" class="bg-surface-container hover:bg-surface-container-high text-on-surface p-1 rounded transition" title="Acercar">
<span class="material-symbols-outlined text-[16px]">add</span>
</button>
<button id="visorZoomOut" class="bg-surface-container hover:bg-surface-container-high text-on-surface p-1 rounded transition" title="Alejar">
<span class="material-symbols-outlined text-[16px]">remove</span>
</button>
<button id="visorRecenter" class="bg-surface-container hover:bg-surface-container-high text-on-surface p-1 rounded transition" title="Centrar">
<span class="material-symbols-outlined text-[16px]">filter_center_focus</span>
</button>
<button class="bg-primary text-on-primary font-label-sm text-label-sm px-2 py-1 rounded font-bold uppercase ml-2 flex items-center gap-1 opacity-60 cursor-not-allowed" disabled title="Función en preparación">
<span class="material-symbols-outlined text-[14px]">download</span> Exportar GeoJSON
          </button>
</div>
</div>
</div>
<!-- Lado Derecho: Panel de Lectura Analítica (5 cols ~ 40-42%) -->
<div class="lg:col-span-5 flex flex-col bg-surface-container-low rounded-lg p-space-md shadow-xl justify-between">
<!-- Intel Header / Classification Rail -->
<div>
<div class="flex items-center justify-between mb-space-sm pb-space-xs">
<div class="flex items-center gap-2">
<span class="bg-error-container text-on-error-container font-label-sm text-label-sm px-2 py-0.5 font-bold uppercase rounded">
              VERIFICADO
            </span>
<span class="font-label-sm text-label-sm text-outline" id="intelRegion">SEC: {active.region.toUpperCase()}</span>
</div>
<span class="font-label-sm text-label-sm text-primary flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">timer</span> <span id="intelThreat">AMENAZA {active.threat.toUpperCase()}</span>
          </span>
</div>
<h2 id="intelTitle" class="font-headline-md text-headline-md text-on-surface uppercase tracking-tight mb-space-xs">
          {active.name}
        </h2>
<div class="flex items-center gap-space-md text-body-sm font-body-sm text-outline mb-space-md">
<span class="flex items-center gap-1 text-on-surface-variant font-medium">
<span class="material-symbols-outlined text-[16px] text-primary">verified_user</span> <span id="intelSource">{active.source}</span>
          </span>
<span>•</span>
<span id="intelSummary" class="line-clamp-3">{active.summary}</span>
</div>
<!-- Accordion / Strategic Points Breakdown (dinámico por teatro) -->
<div id="intelPoints" class="space-y-space-sm overflow-y-auto max-h-[400px] pr-1">
{active.analysis.map((p, i) => (
  <div class="bg-surface-container p-space-sm rounded transition hover:bg-surface-container-high">
    <div class="flex items-center justify-between mb-1">
      <span class="font-label-sm text-label-sm text-primary font-bold uppercase">{p.title}</span>
      <button class="text-outline hover:text-primary font-label-sm text-label-sm flex items-center gap-1" data-focus-index={i}>
        <span class="material-symbols-outlined text-[14px]">my_location</span> Enfocar
      </button>
    </div>
    <p class="font-body-sm text-body-sm text-on-surface-variant">{p.text}</p>
  </div>
))}
</div>
</div>
<!-- Bottom Sharing Strip & Action Trigger -->
<div class="pt-space-md mt-space-md">
<div class="flex items-center justify-between mb-space-xs">
<span class="font-label-sm text-label-sm text-outline uppercase font-bold">Compartir en Redes</span>
<span class="font-label-sm text-label-sm text-primary font-mono">ENLACE DISPONIBLE</span>
</div>
<div class="grid grid-cols-4 gap-2">
<!-- Telegram -->
<button class="flex items-center justify-center gap-1.5 bg-surface-container hover:bg-surface-container-high text-on-surface py-2 rounded transition font-label-sm text-label-sm">
<span class="material-symbols-outlined text-[16px] text-[#2AABEE]">send</span>
<span>Telegram</span>
</button>
<!-- X / Twitter -->
<button class="flex items-center justify-center gap-1.5 bg-surface-container hover:bg-surface-container-high text-on-surface py-2 rounded transition font-label-sm text-label-sm">
<span class="font-bold text-[14px]">𝕏</span>
<span>X Corp</span>
</button>
<!-- WhatsApp -->
<button class="flex items-center justify-center gap-1.5 bg-surface-container hover:bg-surface-container-high text-on-surface py-2 rounded transition font-label-sm text-label-sm">
<span class="material-symbols-outlined text-[16px] text-primary">chat</span>
<span>WhatsApp</span>
</button>
<!-- Copy Satellite View Link -->
<button class="flex items-center justify-center gap-1.5 bg-primary-container hover:bg-primary-fixed text-on-primary-container py-2 rounded transition font-label-sm text-label-sm font-bold uppercase" onclick="navigator.clipboard.writeText(window.location.href); alert('Enlace de coordenadas copiado al portapapeles.');">
<span class="material-symbols-outlined text-[16px]">link</span>
<span>Copiar Vista</span>
</button>
</div>
</div>
</div>
</section>
<!-- 3. GALERÍA DE MAPAS DISPONIBLES (Catálogo de artículos interactivos) -->
<section class="mb-space-xl">
<div class="flex flex-col md:flex-row md:items-end justify-between mb-space-md">
<div>
<div class="flex items-center gap-2 text-secondary font-label-sm text-label-sm uppercase tracking-wider mb-1">
<span class="material-symbols-outlined text-[16px]">folder_special</span> Catálogo Geoestratégico
        </div>
<h3 class="font-headline-lg text-headline-lg text-on-surface uppercase">
          Teatros Activos Disponibles
        </h3>
        <p class="font-body-md text-body-md text-on-surface-variant mt-1">
          Teatros de conflicto con datos verificados. Selecciona uno para cargarlo en el visor interactivo superior.
        </p>
</div>
<div class="mt-space-sm md:mt-0 flex items-center gap-2">
<span class="font-label-sm text-label-sm text-outline uppercase">ZONAS DISPONIBLES · FUENTES ABIERTAS</span>
</div>
</div>
<!-- Catálogo dinámico de teatros -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-space-md">
{catalog.map((t) => (
  <div class="bg-surface-container-low rounded-lg overflow-hidden shadow-lg hover:-translate-y-1 transition duration-200 flex flex-col justify-between">
    <div>
      <div class="w-full h-44 relative overflow-hidden bg-[#0b0e14]">
        <div id={`miniMap-${t.id}`} class="absolute inset-0 z-0"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-surface-container-low via-surface-container-low/20 to-transparent z-[1000] pointer-events-none"></div>
        <div class={`absolute top-2 left-2 z-[1001] flex items-center gap-1.5 font-label-sm text-label-sm px-2 py-0.5 rounded font-bold uppercase ${t.threat === 'Crítica' ? 'bg-error-container text-on-error-container' : 'bg-tertiary-container text-on-tertiary'}`}>
          <span class={`w-1.5 h-1.5 rounded-full ${t.threat === 'Crítica' ? 'bg-error animate-ping' : 'bg-tertiary'}`}></span>
          Tensión: {t.threat}
        </div>
        <div class="absolute bottom-2 right-2 z-[1001] bg-surface-container-lowest/80 backdrop-blur font-label-sm text-label-sm text-primary px-2 py-0.5 rounded font-mono">
          {t.region}
        </div>
      </div>
      <div class="p-space-md">
        <h4 class="font-headline-sm text-headline-sm text-on-surface uppercase mb-space-xs line-clamp-2">{t.name}</h4>
        <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-3 mb-space-sm">{t.summary}</p>
        <div class="flex flex-wrap gap-1.5">
          {t.stats.map(s => (
            <span class="bg-surface-container px-2 py-0.5 rounded font-label-sm text-label-sm text-on-surface-variant">
              <span class="text-outline">{s.label}:</span> <span class="text-primary font-bold">{s.value}</span>
            </span>
          ))}
        </div>
      </div>
    </div>
    <div class="p-space-md pt-0">
      <button data-theater={t.id} onclick={`window.loadTheater && window.loadTheater('${t.id}')`} class="theater-btn w-full bg-primary text-on-primary hover:bg-primary-fixed active:scale-[0.98] font-label-sm text-label-sm py-2 rounded font-bold uppercase flex items-center justify-center gap-2 transition-all cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">explore</span> Explorar Mapa
      </button>
    </div>
  </div>
))}
</div>
</section>

<script is:inline>
(function () {
  const theaters = JSON.parse(document.getElementById('theatersData').textContent);
  function initMiniMaps() {
    if (typeof L === 'undefined') { setTimeout(initMiniMaps, 200); return; }

    // Mini-mapas para los teatros del catálogo (todos menos el activo)
    theaters.slice(1).forEach(t => {
      const el = document.getElementById('miniMap-' + t.id);
      if (!el) return;
      const m = L.map(el, {
        center: t.center,
        zoom: t.zoom,
        zoomControl: false,
        attributionControl: false,
        dragging: false,
        scrollWheelZoom: false,
        doubleClickZoom: false,
        touchZoom: false,
        keyboard: false
      });
      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
        maxZoom: 16
      }).addTo(m);
      const pin = L.divIcon({
        className: 'mini-pin',
        html: '<div style="position:relative;width:22px;height:22px;display:flex;align-items:center;justify-content:center;"><span class="animate-ping absolute inline-flex h-full w-full rounded-full" style="background:#ef4444;opacity:.7;"></span><span style="position:relative;display:inline-flex;width:11px;height:11px;border-radius:9999px;background:#ef4444;border:2px solid #fff;"></span></div>',
        iconSize: [22, 22], iconAnchor: [11, 11]
      });
      L.marker(t.center, { icon: pin }).addTo(m);
    });

    // Botones "Explorar Mapa" → cargar teatro en el visor
    document.querySelectorAll('.theater-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-theater');
        if (typeof window.loadTheater === 'function') window.loadTheater(id);
      });
    });
  }
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initMiniMaps();
  } else {
    document.addEventListener('DOMContentLoaded', initMiniMaps);
  }
})();
</script>
</div>
</SidebarLayout>
