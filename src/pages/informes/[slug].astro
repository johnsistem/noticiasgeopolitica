---
import { getCollection, type CollectionEntry } from 'astro:content';
import TopNavLayout from '../../layouts/TopNavLayout.astro';

export async function getStaticPaths() {
  const informes = await getCollection('informes');
  return informes.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, allInformes: informes },
  }));
}

type Props = {
  entry: CollectionEntry<'informes'>;
  allInformes: CollectionEntry<'informes'>[];
};

const { entry, allInformes } = Astro.props;
const { Content } = await entry.render();

const related = allInformes
  .filter(i => i.slug !== entry.slug && (i.data.region === entry.data.region || i.data.tags?.some(t => entry.data.tags?.includes(t))))
  .slice(0, 3);
---

<TopNavLayout 
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  article={true}
  publishedTime={entry.data.date}
>
  <article class="max-w-4xl mx-auto px-margin pt-[98px] pb-space-xl text-on-surface">
    <!-- Header metadata -->
    <header class="flex flex-col gap-space-sm mb-space-xl border-b border-surface-container-high pb-space-lg">
      <div class="flex flex-wrap items-center gap-space-xs font-mono text-xs text-primary">
        <span class="bg-primary-container text-on-primary-container px-2 py-0.5 font-bold uppercase rounded">{entry.data.category}</span>
        <span class="bg-tertiary-container text-on-tertiary px-2 py-0.5 font-bold uppercase rounded">{entry.data.defcon}</span>
        <span>•</span>
        <span class="text-outline">{entry.data.date} HORA</span>
        <span>•</span>
        <span class="text-outline">{entry.data.readingTime}</span>
      </div>

      <h1 class="font-headline-xl-mobile text-headline-xl-mobile md:font-headline-xl md:text-headline-xl text-on-surface uppercase tracking-tight leading-tight">
        {entry.data.title}
      </h1>

      <p class="font-body-lg text-body-lg text-on-surface-variant">
        {entry.data.description}
      </p>

      <div class="flex items-center gap-space-md pt-space-xs font-mono text-xs text-outline">
        <span class="text-primary font-bold">ANALISTA: {entry.data.author}</span>
        <span>|</span>
        <span>SECTORES: {(entry.data.hotspots && entry.data.hotspots.length > 0) ? entry.data.hotspots.join(', ') : (entry.data.region || 'GLOBAL')}</span>
      </div>
    </header>

    <!-- Main Hero Section: Facebook Video, YouTube Video, Live Leaflet Map, or Hero Image -->
    {entry.data.facebook_url ? (
      <div class="mb-space-xl rounded-xl overflow-hidden border border-primary/40 shadow-2xl bg-black aspect-video relative">
        <iframe 
          src={`https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(entry.data.facebook_url)}&show_text=false&t=0`} 
          class="w-full h-full border-none overflow-hidden" 
          scrolling="no" 
          frameborder="0" 
          allowfullscreen="true" 
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share">
        </iframe>
      </div>
    ) : entry.data.youtube_id ? (
      <div class="mb-space-xl rounded-xl overflow-hidden border border-primary/40 shadow-2xl bg-black aspect-video relative">
        <iframe 
          src={`https://www.youtube.com/embed/${entry.data.youtube_id}`} 
          class="w-full h-full border-none overflow-hidden" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen>
        </iframe>
      </div>
    ) : null}

    <!-- Hero Image (always show if exists) -->
    {entry.data.image && (
      <div class="mb-space-xl rounded-xl overflow-hidden border border-primary/30 shadow-2xl">
        <img src={entry.data.image} alt={entry.data.title} class="w-full rounded-xl" onerror="this.parentElement.style.display='none'" />
      </div>
    )}

    <!-- Live Leaflet Map (shows after video if coordinates exist) -->
    {entry.data.coordinates && (
      <div class="mb-space-xl rounded-xl overflow-hidden border border-primary/30 shadow-2xl bg-[#0b0e14] relative group">
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

        <div id="articleMap" class="w-full h-[420px] z-10"></div>

        <!-- Military Telemetry HUD Overlay -->
        <div class="absolute top-3 left-3 right-3 flex items-center justify-between font-mono text-xs z-20 pointer-events-none">
          <div class="bg-surface-container-lowest/90 px-3 py-1 rounded backdrop-blur-md border border-primary/30 text-primary font-bold flex items-center gap-2 shadow-lg">
            <span class="w-2 h-2 rounded-full bg-error animate-ping"></span>
            <span>UBICACIÓN // COORDENADAS</span>
          </div>
          <div class="bg-surface-container-lowest/90 px-3 py-1 rounded backdrop-blur-md border border-secondary/40 text-secondary font-bold shadow-lg">
            <span>LAT {entry.data.coordinates.lat}° N // LON {entry.data.coordinates.lon}° E</span>
          </div>
        </div>

        <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between font-mono text-xs z-20 pointer-events-none">
          <div class="bg-surface-container-lowest/90 px-2 py-0.5 rounded backdrop-blur-sm text-outline border border-surface-container-high">
            <span>NIVEL AMENAZA: <strong class="text-error">{entry.data.threat_level || 'ALTA'}</strong></span>
          </div>
          <div class="bg-surface-container-lowest/90 px-2 py-0.5 rounded backdrop-blur-sm text-primary border border-surface-container-high">
            <span>REGIÓN: {entry.data.region || 'MAR ROJO'}</span>
          </div>
        </div>

        <!-- Leaflet Map Initialization Script -->
        <script is:inline define:vars={{ lat: entry.data.coordinates.lat, lon: entry.data.coordinates.lon, title: entry.data.title }}>
          function initArticleMap() {
            if (typeof L !== 'undefined' && document.getElementById('articleMap')) {
              const map = L.map('articleMap', {
                center: [lat, lon],
                zoom: 9,
                zoomControl: true,
                attributionControl: false
              });

              L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
                maxZoom: 16,
                attribution: 'Tiles &copy; Esri'
              }).addTo(map);

              const pulseIcon = L.divIcon({
                className: 'custom-pulse-marker',
                html: `<div class="relative flex items-center justify-center w-8 h-8">
                         <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75"></span>
                         <span class="relative inline-flex rounded-full h-4 w-4 bg-red-600 border-2 border-white shadow-xl"></span>
                       </div>`,
                iconSize: [32, 32],
                iconAnchor: [16, 16]
              });

              const marker = L.marker([lat, lon], { icon: pulseIcon }).addTo(map);
              marker.bindPopup(`<div style="color: #10b981; font-family: monospace; font-weight: bold; font-size: 13px;">${title}</div><div style="color: #9ca3af; font-family: monospace; font-size: 11px; margin-top: 4px;">Ubicación: ${lat}° N, ${lon}° E</div>`).openPopup();
            } else {
              setTimeout(initArticleMap, 200);
            }
          }
          if (document.readyState === 'complete' || document.readyState === 'interactive') {
            initArticleMap();
          } else {
            document.addEventListener('DOMContentLoaded', initArticleMap);
          }
        </script>
      </div>
    )}

    <!-- MDX Rendered Body -->
    <div class="prose prose-invert max-w-none font-body-md text-on-surface-variant leading-relaxed space-y-space-md">
      <Content />
    </div>

    <!-- Otras Noticias Relacionadas -->
    {related.length > 0 && (
      <section class="mt-space-xl pt-space-lg border-t border-surface-container-high">
        <h2 class="font-headline-lg text-headline-lg text-on-surface uppercase mb-space-md">OTRAS NOTICIAS RELACIONADAS</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
          {related.map((rel) => (
            <a href={`/informes/${rel.slug}`} class="bg-surface-container rounded-xl overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-1 transition-all flex flex-col group border border-primary/10">
              <div class="p-space-md flex flex-col gap-space-xs flex-1">
                <div class="flex items-center gap-2 font-label-sm text-label-sm">
                  <span class="bg-primary-container text-on-primary-container px-2 py-0.5 rounded font-bold uppercase">{rel.data.category}</span>
                  <span class="text-outline">{rel.data.date}</span>
                </div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors line-clamp-3">{rel.data.title}</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mt-auto">{rel.data.description}</p>
              </div>
              <div class="px-space-md pb-space-md">
                <span class="font-label-sm text-label-sm text-primary font-bold flex items-center gap-1">LEER MÁS <span class="material-symbols-outlined text-[14px]">arrow_forward</span></span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Footer Action -->
    <footer class="mt-space-xl pt-space-md border-t border-surface-container-high flex flex-col md:flex-row items-center justify-between gap-space-md">
      <a href="/informes" class="font-label-md text-label-md uppercase bg-surface-container hover:bg-surface-container-high text-primary px-space-md py-2 rounded font-bold transition-colors flex items-center gap-space-xs">
        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        VOLVER A INFORMES
      </a>
      <button onclick="window.print()" class="font-label-md text-label-md uppercase border border-outline hover:border-primary text-on-surface px-space-md py-2 rounded font-bold transition-colors flex items-center gap-space-xs">
        <span class="material-symbols-outlined text-[18px]">print</span>
        EXPORTAR INFORME (PDF)
      </button>
    </footer>
  </article>
</TopNavLayout>
