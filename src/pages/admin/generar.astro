---
import TopNavLayout from '../../layouts/TopNavLayout.astro'
---

<TopNavLayout title="Generador de Contenido | Admin" description="Panel de administración para generar contenido con IA">

<!-- AUTH GATE -->
<div id="auth-gate" class="fixed inset-0 z-[9999] bg-black flex items-center justify-center">
  <div class="bg-surface-container p-8 rounded-xl shadow-2xl flex flex-col gap-4 items-center max-w-sm w-full mx-4 border border-error/30">
    <span class="material-symbols-outlined text-error text-[48px]">lock</span>
    <h2 class="font-headline-lg text-headline-lg text-on-surface uppercase text-center">ACCESO RESTRINGIDO</h2>
    <p class="font-label-sm text-label-sm text-outline text-center">Panel de administración. Ingresa la contraseña.</p>
    <input id="admin-pass" type="password" placeholder="Contraseña" class="w-full bg-surface-container-lowest text-on-surface px-4 py-3 rounded font-label-md text-label-md focus:outline-none placeholder:text-outline text-center" onkeydown="if(event.key==='Enter')checkPass()" />
    <button onclick="checkPass()" class="w-full bg-primary text-on-primary font-label-md text-label-md uppercase py-3 rounded font-bold hover:bg-primary-fixed transition-all">ENTRAR</button>
    <p id="pass-error" class="text-error font-label-sm text-label-sm hidden">Contraseña incorrecta</p>
  </div>
</div>
<script is:inline>
function checkPass() {
  var pass = document.getElementById('admin-pass').value;
  if (pass === 'filosofia1972') {
    document.getElementById('auth-gate').remove();
    sessionStorage.setItem('admin_auth', '1');
  } else {
    document.getElementById('pass-error').classList.remove('hidden');
    document.getElementById('admin-pass').value = '';
    document.getElementById('admin-pass').focus();
  }
}
if (sessionStorage.getItem('admin_auth') === '1') {
  document.getElementById('auth-gate').remove();
}
</script>

<div class="min-h-screen bg-background py-12 px-4">
  <div class="max-w-5xl mx-auto flex flex-col gap-8">

    <!-- Header -->
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-2 text-primary font-label-md text-label-md uppercase">
        <span class="material-symbols-outlined text-[20px]">smart_toy</span>
        <span>PANEL DE GENERACIÓN</span>
      </div>
      <h1 class="font-headline-xl text-headline-xl text-on-surface uppercase">GENERADOR DE CONTENIDO IA</h1>
      <p class="font-body-md text-body-md text-on-surface-variant">Pega una URL o texto y genera cualquier tipo de contenido para el sitio.</p>
    </div>

    <!-- Formulario -->
    <form id="gen-form" class="bg-surface-container-low p-6 rounded-xl flex flex-col gap-6 shadow-lg">

      <!-- URL / Texto -->
      <div class="flex flex-col gap-2">
        <label class="font-label-sm text-label-sm text-outline uppercase">URL de la noticia (o pega el texto abajo)</label>
        <input id="gen-url" type="url" placeholder="https://ejemplo.com/noticia-geopolitica" class="w-full bg-surface-container-lowest text-on-surface px-4 py-3 rounded font-label-md text-label-md focus:outline-none placeholder:text-outline" />
      </div>

      <div class="flex flex-col gap-2">
        <label class="font-label-sm text-label-sm text-outline uppercase">Texto alternativo (si no hay URL)</label>
        <textarea id="gen-text" rows="4" placeholder="Pega aquí el texto de la noticia..." class="w-full bg-surface-container-lowest text-on-surface px-4 py-3 rounded font-label-md text-label-md focus:outline-none placeholder:text-outline resize-y"></textarea>
      </div>

      <!-- Tipo de contenido -->
      <div class="flex flex-col gap-2">
        <label class="font-label-sm text-label-sm text-outline uppercase">Tipo de contenido</label>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <button type="button" data-type="cable" class="gen-type-btn bg-primary text-on-primary border-primary">
            <span class="text-lg">⚡</span> Cable Flash
          </button>
          <button type="button" data-type="informe" class="gen-type-btn bg-surface-container-high text-on-surface border-surface-container-highest">
            <span class="text-lg">📄</span> Informe
          </button>
          <button type="button" data-type="perfil" class="gen-type-btn bg-surface-container-high text-on-surface border-surface-container-highest">
            <span class="text-lg">👤</span> Perfil País
          </button>
          <button type="button" data-type="comparativo" class="gen-type-btn bg-surface-container-high text-on-surface border-surface-container-highest">
            <span class="text-lg">📊</span> Comparativo
          </button>
          <button type="button" data-type="timeline" class="gen-type-btn bg-surface-container-high text-on-surface border-surface-container-highest">
            <span class="text-lg">📅</span> Timeline
          </button>
          <button type="button" data-type="resumen" class="gen-type-btn bg-surface-container-high text-on-surface border-surface-container-highest">
            <span class="text-lg">📰</span> Resumen Semanal
          </button>
          <button type="button" data-type="post" class="gen-type-btn bg-surface-container-high text-on-surface border-surface-container-highest">
            <span class="text-lg">📱</span> Post Redes
          </button>
          <button type="button" data-type="geoespacial" class="gen-type-btn bg-surface-container-high text-on-surface border-surface-container-highest">
            <span class="text-lg">🗺️</span> Geoespacial
          </button>
        </div>
      </div>

      <!-- Opciones -->
      <div class="flex flex-wrap items-center gap-4">
        <label class="flex items-center gap-2 cursor-pointer select-none">
          <input type="checkbox" id="gen-map" class="sr-only peer" />
          <div class="w-10 h-6 bg-surface-container-highest rounded-full peer-checked:bg-primary transition-colors relative">
            <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-on-surface rounded-full transition-transform peer-checked:translate-x-4"></div>
          </div>
          <span class="font-label-md text-label-md text-on-surface-variant">Incluir mapa</span>
        </label>
        <div class="flex items-center gap-2 flex-1 min-w-[250px]">
          <input id="gen-image-url" type="url" placeholder="URL de imagen (opcional)" class="flex-1 bg-surface-container-lowest text-on-surface px-3 py-2 rounded font-label-md text-label-md focus:outline-none placeholder:text-outline" />
          <label for="gen-image-file" id="gen-image-btn" class="cursor-pointer bg-surface-container-high hover:bg-surface-container-highest px-3 py-2 rounded transition-colors flex items-center gap-1">
            <span class="material-symbols-outlined text-[18px] text-primary">attach_file</span>
            <span id="gen-image-label" class="font-label-sm text-label-sm text-on-surface-variant">Imagen</span>
          </label>
          <input id="gen-image-file" type="file" accept="image/*" class="hidden" />
        </div>
      </div>

      <!-- Botón generar -->
      <button id="gen-btn" type="submit" class="w-full bg-primary text-on-primary font-label-lg text-label-lg uppercase py-4 rounded font-bold hover:bg-primary-fixed transition-all flex items-center justify-center gap-2 shadow-md">
        <span class="material-symbols-outlined text-[20px]">radar</span>
        <span>GENERAR CONTENIDO</span>
      </button>
    </form>

    <!-- Loading -->
    <div id="gen-loading" class="hidden bg-surface-container-low p-8 rounded-xl flex flex-col items-center gap-4">
      <div class="w-12 h-12 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
      <span class="font-label-md text-label-md text-on-surface-variant">Generando contenido con IA...</span>
    </div>

    <!-- Preview -->
    <div id="gen-preview" class="hidden bg-surface-container-low p-6 rounded-xl flex flex-col gap-4 shadow-lg">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-2 text-primary font-label-md text-label-md uppercase">
          <span class="material-symbols-outlined text-[18px]">preview</span>
          <span>PREVIEW</span>
        </div>
        <div class="flex gap-2 flex-wrap">
          <button id="btn-regenerate" type="button" class="bg-secondary-container text-on-secondary-container font-label-sm text-label-sm uppercase px-4 py-2 rounded flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px]">refresh</span>
            Regenerar
          </button>
          <button id="btn-copy" type="button" class="bg-surface-container-high hover:bg-surface-bright text-on-surface font-label-sm text-label-sm uppercase px-4 py-2 rounded flex items-center gap-1 transition-colors">
            <span class="material-symbols-outlined text-[16px]">content_copy</span>
            Copiar
          </button>
          <button id="btn-save" type="button" class="bg-primary text-on-primary font-label-sm text-label-sm uppercase px-4 py-2 rounded font-bold flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px]">save</span>
            Guardar en Repo
          </button>
        </div>
      </div>

      <!-- Slug preview -->
      <div class="bg-surface-container p-3 rounded flex items-center gap-2">
        <span class="font-label-sm text-label-sm text-outline">ARCHIVO:</span>
        <span id="gen-slug" class="font-label-md text-label-md text-primary font-mono"></span>
      </div>

      <!-- Tabs: Markdown / Preview -->
      <div class="flex gap-2 border-b border-surface-container-highest pb-2">
        <button id="tab-md" class="tab-btn bg-primary text-on-primary px-4 py-1.5 rounded font-label-sm text-label-sm font-bold">Markdown</button>
        <button id="tab-rendered" class="tab-btn bg-surface-container-high text-on-surface-variant px-4 py-1.5 rounded font-label-sm text-label-sm">Vista previa</button>
        <button id="tab-edit" class="tab-btn bg-surface-container-high text-on-surface-variant px-4 py-1.5 rounded font-label-sm text-label-sm">Editar</button>
      </div>

      <!-- Tab content: Markdown -->
      <div id="panel-md" class="tab-panel">
        <pre id="gen-markdown" class="bg-surface-container-lowest p-4 rounded overflow-auto max-h-[500px] font-mono text-sm text-on-surface-variant whitespace-pre-wrap"></pre>
      </div>

      <!-- Tab content: Rendered -->
      <div id="panel-rendered" class="tab-panel hidden">
        <div id="gen-rendered" class="bg-surface-container-lowest p-6 rounded prose prose-invert max-w-none"></div>
      </div>

      <!-- Tab content: Edit -->
      <div id="panel-edit" class="tab-panel hidden">
        <textarea id="gen-editor" class="w-full bg-surface-container-lowest text-on-surface p-4 rounded font-mono text-sm min-h-[400px] resize-y focus:outline-none"></textarea>
      </div>
    </div>

    <!-- Estado del guardado -->
    <div id="gen-status" class="hidden bg-surface-container-low p-4 rounded-xl flex items-center gap-3"></div>

  </div>
</div>

<style>
  .gen-type-btn {
    @apply px-4 py-3 rounded-lg font-label-sm text-label-sm uppercase font-bold border-2 cursor-pointer transition-all text-center flex flex-col items-center gap-1;
  }
</style>

<script is:inline>
(function() {
  let selectedType = 'cable'
  let generatedMarkdown = ''
  let generatedSlug = ''
  let lastUrl = ''
  let lastText = ''
  let activeTab = 'md'
  let attachedImageBase64 = ''
  let attachedImageName = ''

  // File upload
  document.getElementById('gen-image-file').addEventListener('change', function(e) {
    var file = e.target.files[0]
    if (!file) return
    attachedImageName = 'uploads/' + Date.now() + '-' + file.name.replace(/[^a-zA-Z0-9._-]/g, '_')
    document.getElementById('gen-image-label').textContent = file.name.substring(0, 20)
    document.getElementById('gen-image-btn').className = 'cursor-pointer bg-primary/20 border border-primary px-3 py-2 rounded transition-colors flex items-center gap-1'
    var reader = new FileReader()
    reader.onload = function(ev) {
      attachedImageBase64 = ev.target.result
    }
    reader.readAsDataURL(file)
  })

  // Type buttons
  document.querySelectorAll('.gen-type-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedType = btn.dataset.type
      document.querySelectorAll('.gen-type-btn').forEach(b => {
        b.className = 'gen-type-btn bg-surface-container-high text-on-surface border-surface-container-highest'
      })
      btn.className = 'gen-type-btn bg-primary text-on-primary border-primary'
    })
  })

  function switchTab(active) {
    activeTab = active
    document.querySelectorAll('.tab-btn').forEach(b => {
      b.className = 'tab-btn bg-surface-container-high text-on-surface-variant px-4 py-1.5 rounded font-label-sm text-label-sm'
    })
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'))
    document.getElementById('tab-' + active).className = 'tab-btn bg-primary text-on-primary px-4 py-1.5 rounded font-label-sm text-label-sm font-bold'
    document.getElementById('panel-' + active).classList.remove('hidden')
  }

  document.getElementById('tab-md').addEventListener('click', () => switchTab('md'))
  document.getElementById('tab-rendered').addEventListener('click', () => {
    switchTab('rendered')
    doRender()
  })
  document.getElementById('tab-edit').addEventListener('click', () => {
    document.getElementById('gen-editor').value = generatedMarkdown
    switchTab('edit')
  })

  function doRender() {
    var md = generatedMarkdown
    if (!md) {
      document.getElementById('gen-rendered').innerHTML = '<p class="text-on-surface-variant">Genera contenido primero.</p>'
      return
    }
    // Extract image from frontmatter before removing it
    var heroImg = ''
    var fmMatch = md.match(/^---\s*\n([\s\S]*?)\n---/)
    if (fmMatch) {
      var imgField = fmMatch[1].match(/image:\s*['"]?([^'"\n]+)['"]?/)
      if (imgField && (imgField[1].startsWith('http') || imgField[1].startsWith('data:image'))) heroImg = imgField[1]
    }
    md = md.replace(/^---[\s\S]*?---\n*/m, '')
    var hero = heroImg ? '<img src="' + heroImg + '" alt="Imagen destacada" class="w-full rounded-xl mb-6 max-h-[400px] object-cover" onerror="this.style.display=\'none\'" />' : ''
    document.getElementById('gen-rendered').innerHTML = hero + parseMd(md)
  }

  function parseMd(md) {
    var html = ''
    var lines = md.split('\n')
    var inList = false
    var inTable = false
    var tableRows = []

    for (var i = 0; i < lines.length; i++) {
      var line = lines[i]
      var trim = line.trim()
      if (!trim) {
        if (inList) { html += '</ul>'; inList = false }
        if (inTable) { html += buildTable(tableRows); tableRows = []; inTable = false }
        continue
      }
      // frontmatter
      if (trim === '---') continue
      // table row
      if (trim.startsWith('|') && trim.endsWith('|')) {
        if (/^\|[\s\-:|]+\|$/.test(trim)) continue
        if (!inTable) inTable = true
        var cells = trim.split('|').slice(1, -1).map(function(c) { return c.trim() })
        tableRows.push(cells)
        continue
      } else if (inTable) {
        html += buildTable(tableRows)
        tableRows = []
        inTable = false
      }
      // headers
      if (trim.startsWith('#### ')) { html += '<h4 class="text-base font-semibold text-on-surface mt-3 mb-1">' + inline(trim.slice(5)) + '</h4>'; continue }
      if (trim.startsWith('### ')) { html += '<h3 class="text-lg font-bold text-on-surface mt-4 mb-2">' + inline(trim.slice(4)) + '</h3>'; continue }
      if (trim.startsWith('## ')) { html += '<h2 class="text-xl font-bold text-on-surface mt-5 mb-2">' + inline(trim.slice(3)) + '</h2>'; continue }
      if (trim.startsWith('# ')) { html += '<h1 class="text-2xl font-bold text-on-surface mt-6 mb-3">' + inline(trim.slice(2)) + '</h1>'; continue }
      // image
      if (/^!\[.*?\]\(.*?\)$/.test(trim)) {
        var m = trim.match(/!\[([^\]]*)\]\(([^)]+)\)/)
        if (m) html += '<img src="' + esc(m[2]) + '" alt="' + esc(m[1]) + '" class="w-full rounded-lg my-4" />'
        continue
      }
      // unordered list
      if (trim.startsWith('- ')) {
        if (!inList) { html += '<ul class="list-disc ml-5 mb-3 text-on-surface-variant space-y-1">'; inList = true }
        html += '<li>' + inline(trim.slice(2)) + '</li>'
        continue
      }
      // ordered list
      if (/^\d+\.\s/.test(trim)) {
        if (!inList) { html += '<ol class="list-decimal ml-5 mb-3 text-on-surface-variant space-y-1">'; inList = true }
        html += '<li>' + inline(trim.replace(/^\d+\.\s/, '')) + '</li>'
        continue
      }
      // paragraph
      html += '<p class="text-on-surface-variant mb-3 leading-relaxed">' + inline(trim) + '</p>'
    }
    if (inList) html += '</ul>'
    if (inTable) html += buildTable(tableRows)
    return html || '<p class="text-on-surface-variant">Sin contenido</p>'
  }

  function buildTable(rows) {
    if (!rows.length) return ''
    var h = '<div class="overflow-x-auto my-4"><table class="w-full text-sm border-collapse">'
    h += '<thead><tr>' + rows[0].map(function(c) { return '<th class="px-3 py-2 text-left bg-surface-container-high border border-surface-container-highest text-on-surface font-bold">' + inline(c) + '</th>' }).join('') + '</tr></thead>'
    h += '<tbody>'
    for (var r = 1; r < rows.length; r++) {
      h += '<tr>' + rows[r].map(function(c) { return '<td class="px-3 py-2 border border-surface-container-highest text-on-surface-variant">' + inline(c) + '</td>' }).join('') + '</tr>'
    }
    h += '</tbody></table></div>'
    return h
  }

  function inline(s) {
    return s
      .replace(/\*\*(.+?)\*\*/g, '<strong class="text-on-surface font-bold">$1</strong>')
      .replace(/\*(.+?)\*/g, '<em class="text-on-surface-variant">$1</em>')
      .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1" class="max-h-40 rounded my-2" />')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-primary hover:underline" target="_blank">$1</a>')
      .replace(/`([^`]+)`/g, '<code class="bg-surface-container-highest px-1.5 py-0.5 rounded text-sm text-primary">$1</code>')
  }

  function esc(s) { return s.replace(/"/g, '&quot;').replace(/</g, '&lt;') }

  // Generate content
  async function generate() {
    var url = document.getElementById('gen-url').value.trim()
    var text = document.getElementById('gen-text').value.trim()
    var withMap = document.getElementById('gen-map').checked
    var customImage = document.getElementById('gen-image-url').value.trim() || attachedImageBase64 || ''
    lastUrl = url
    lastText = text
    if (!url && !text) { alert('Pega una URL o texto'); return }

    var loading = document.getElementById('gen-loading')
    var preview = document.getElementById('gen-preview')
    var status = document.getElementById('gen-status')
    loading.classList.remove('hidden')
    preview.classList.add('hidden')
    status.classList.add('hidden')

    try {
      var res = await fetch('/api/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: url || text, type: selectedType, withMap: withMap, customImage: customImage }),
      })
      var data = await res.json()
      if (data.error) throw new Error(data.error)

      generatedMarkdown = data.markdown
      generatedSlug = data.slug

      var collection = selectedType === 'cable' ? 'cables' : 'informes'
      document.getElementById('gen-slug').textContent = 'src/content/' + collection + '/' + generatedSlug + '.md'
      document.getElementById('gen-markdown').textContent = generatedMarkdown

      loading.classList.add('hidden')
      preview.classList.remove('hidden')
      switchTab('md')
    } catch (err) {
      loading.classList.add('hidden')
      status.innerHTML = '<span class="material-symbols-outlined text-error text-[20px]">error</span><span class="font-label-md text-label-md text-error">ERROR: ' + err.message + '</span>'
      status.classList.remove('hidden')
    }
  }

  document.getElementById('gen-form').addEventListener('submit', function(e) { e.preventDefault(); generate() })
  document.getElementById('btn-regenerate').addEventListener('click', generate)

  document.getElementById('btn-copy').addEventListener('click', function() {
    navigator.clipboard.writeText(generatedMarkdown)
    var btn = document.getElementById('btn-copy')
    btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">check</span> Copiado'
    setTimeout(function() { btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">content_copy</span> Copiar' }, 2000)
  })

  document.getElementById('btn-save').addEventListener('click', async function() {
    var collection = selectedType === 'cable' ? 'cables' : 'informes'
    var path = 'src/content/' + collection + '/' + generatedSlug + '.md'
    var btn = document.getElementById('btn-save')
    var status = document.getElementById('gen-status')
    btn.disabled = true
    btn.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">progress_activity</span> Guardando...'
    try {
      // If there's an attached base64 image, upload it first
      var contentToSave = generatedMarkdown
      if (attachedImageBase64 && attachedImageName) {
        var imgRes = await fetch('/api/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ path: 'public/' + attachedImageName, content: attachedImageBase64 }),
        })
        var imgData = await imgRes.json()
        if (imgData.error) throw new Error(imgData.error)
        contentToSave = contentToSave.replace(/^image:.*$/gm, "image: '/" + attachedImageName + "'")
        if (!contentToSave.includes('image:')) {
          contentToSave = contentToSave.replace(/^---\s*\n/, "---\nimage: '/" + attachedImageName + "'\n")
        }
      }
      var res = await fetch('/api/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: path, content: contentToSave }),
      })
      var data = await res.json()
      if (data.error) throw new Error(data.error)
      status.innerHTML = '<span class="material-symbols-outlined text-primary text-[20px]">check_circle</span><span class="font-label-md text-label-md text-primary">Guardado en ' + path + ' — Vercel hará deploy automáticamente</span>'
      status.classList.remove('hidden')
      btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">check</span> Guardado'
    } catch (err) {
      status.innerHTML = '<span class="material-symbols-outlined text-error text-[20px]">error</span><span class="font-label-md text-label-md text-error">ERROR: ' + err.message + '</span>'
      status.classList.remove('hidden')
      btn.disabled = false
      btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">save</span> Guardar en Repo'
    }
  })
})()
</script>
</TopNavLayout>
