<span class="font-label-sm text-label-sm text-outline">Desvío por Cabo de Buena Esperanza</span>
</div>
</div>
</div>
<!-- SECTION 3: AI EXTENDED TRANSCRIPTION & SEO INDEXING ENGINE -->
<div class="w-full bg-surface-container-low rounded-xl p-space-lg shadow-xl flex flex-col gap-space-lg">
<!-- AI Banner & SEO Badge -->
<div class="bg-surface-container p-space-md rounded-lg flex flex-col lg:flex-row items-start lg:items-center justify-between gap-space-md shadow-sm">
<div class="flex items-center gap-space-md">
