<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-sm pt-space-xs">
<div class="bg-surface-container-low hover:bg-surface-container-high p-space-sm rounded cursor-pointer transition-colors flex flex-col gap-1">
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-primary font-bold">00:00</span>
<span class="font-label-sm text-label-sm text-outline">PARTE I</span>
</div>
