<!-- Visor de Mapa Táctico REAL (Perim / Bab el-Mandeb) -->
<div class="relative w-full aspect-video bg-[#0b0e14] rounded-lg overflow-hidden group shadow-xl">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <div id="perimFeaturedMap" class="w-full h-full z-0"></div>

  <!-- Tactical HUD Reticle & Crosshair Overlays -->
  <div class="absolute inset-0 pointer-events-none p-space-md flex flex-col justify-between z-[600]">
    <div class="flex items-center justify-between text-primary font-label-sm text-label-sm">
      <div class="bg-surface-container-lowest/85 px-2 py-1 rounded backdrop-blur-sm flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-error animate-ping"></span>
        <span>MAPA ILUSTRATIVO · ISLA DE PERIM · SECTOR YEMEN</span>
      </div>
      <div class="bg-surface-container-lowest/85 px-2 py-1 rounded backdrop-blur-sm">
        <span>GEO-LOC: 12.5883°N 43.3333°E</span>
      </div>
    </div>
    <div class="flex items-center justify-between text-outline font-label-sm text-label-sm">
      <div class="bg-surface-container-lowest/85 px-2 py-1 rounded backdrop-blur-sm">
        <span>CAPAS: RUTAS MARÍTIMAS · ALCANCE A2/AD (EST.)</span>
      </div>
      <div class="bg-surface-container-lowest/85 px-2 py-1 rounded backdrop-blur-sm text-primary">
        <span>● MAPA INTERACTIVO · PANTALLA COMPLETA</span>
      </div>
    </div>
  </div>

  <script is:inline>
    function initPerimFeaturedMap() {
      if (typeof L === 'undefined' || !document.getElementById('perimFeaturedMap')) {
        setTimeout(initPerimFeaturedMap, 200);
        return;
      }
      const m = L.map('perimFeaturedMap', {
        center: [12.6534, 43.4182],
        zoom: 9,
        zoomControl: true,
        attributionControl: false,
        scrollWheelZoom: false
      });
      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
        maxZoom: 16
      }).addTo(m);

      const pulse = L.divIcon({
        className: 'perim-pulse',
        html: '<div style="position:relative;width:32px;height:32px;display:flex;align-items:center;justify-content:center;"><span class="animate-ping absolute inline-flex h-full w-full rounded-full" style="background:#ef4444;opacity:.75;"></span><span style="position:relative;display:inline-flex;width:14px;height:14px;border-radius:9999px;background:#ef4444;border:2px solid #fff;box-shadow:0 0 14px rgba(239,68,68,.8);"></span></div>',
        iconSize: [32, 32], iconAnchor: [16, 16]
      });
      const square = L.divIcon({
        className: 'perim-square',
        html: '<div style="width:12px;height:12px;border-radius:3px;background:#38bdf8;border:2px solid #fff;transform:rotate(45deg);"></div>',
        iconSize: [12, 12], iconAnchor: [6, 6]
      });

      L.marker([12.6534, 43.4182], { icon: pulse }).addTo(m).bindPopup('ISLA DE PERIM (MAYYUN) — Batería de Misiles & Pista Táctica');
      L.marker([12.7821, 43.5109], { icon: square }).addTo(m).bindPopup('Puesto de Radar Costero');
      L.marker([12.6102, 43.3411], { icon: square }).addTo(m).bindPopup('Canal Bab Iskander (2.9 Nmi)');
      L.marker([12.821, 43.284], { icon: square }).addTo(m).bindPopup('Fondeadero VLCC (EST.)');

      // Rutas AIS estimadas
      [[[13.20, 43.05], [12.65, 43.42], [12.10, 43.75]], [[13.45, 42.95], [12.90, 43.30], [12.30, 43.95]]].forEach((pts, idx) => {
        L.polyline(pts, { color: idx === 0 ? '#10b981' : '#38bdf8', weight: 2, opacity: 0.8, dashArray: idx === 0 ? null : '6 8' }).addTo(m);
      });

      // Cobertura A2/AD teórica
      L.circle([12.6534, 43.4182], { radius: 300000, color: '#ef4444', weight: 1.5, dashArray: '5 6', fill: true, fillColor: '#ef4444', fillOpacity: 0.05, opacity: 0.5 }).addTo(m);
    }
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initPerimFeaturedMap();
    } else {
      document.addEventListener('DOMContentLoaded', initPerimFeaturedMap);
    }
  </script>
</div>
