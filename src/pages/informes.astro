---
import TopNavLayout from '../layouts/TopNavLayout.astro';
import { getCollection } from 'astro:content';

const informesCollection = await getCollection('informes');

// Conteos reales por región/categoría de los informes
const countOriente = informesCollection.filter(i => ['Mar Rojo', 'Oriente Medio', 'Arabia Saudita', 'Yemen', 'Golfo Pérsico'].includes(i.data.region)).length;
const countAsiaPac = informesCollection.filter(i => ['Indo-Pacífico', 'Asia-Pacífico', 'Estrecho de Taiwán'].includes(i.data.region)).length;
const countEuropa = informesCollection.filter(i => ['Europa Oriental', 'Báltico', 'Mar Negro'].includes(i.data.region)).length;
const countGlobal = informesCollection.filter(i => ['Global', 'Latinoamérica'].includes(i.data.region)).length;
