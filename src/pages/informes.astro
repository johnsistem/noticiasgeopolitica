---
import TopNavLayout from '../layouts/TopNavLayout.astro';
import { getCollection } from 'astro:content';

const informesCollection = await getCollection('informes');
---

<TopNavLayout>
<div class="flex flex-col w-full">
<!-- SECTION: SUB-HEADER / TAXONOMY & SEO CONTROL DECK -->
<section class="w-full bg-surface-container-lowest px-gutter py-space-xl">
<div class="max-w-7xl mx-auto flex flex-col gap-space-lg">
<!-- Operational Telemetry Bar -->
<div class="flex flex-wrap items-center justify-between gap-space-sm bg-surface-container-low px-space-md py-space-xs rounded">
<div class="flex items-center gap-space-sm">
<span class="font-label-sm text-label-sm uppercase bg-primary-container text-on-primary-container px-2 py-0.5 font-bold">OSINT REPO ACTIVE</span>
<span class="font-label-sm text-label-sm text-on-surface-variant font-medium">INDEXADOR SEMÁNTICO V4.2 // MULTI-PLATFORM SYNC</span>
</div>
<div class="flex items-center gap-space-md text-on-surface-variant font-label-sm text-label-sm">
<span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-primary inline-block"></span> YT FEED: LIVE SYNC</span>
<span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-secondary inline-block"></span> META API: VERIFIED</span>
<span class="text-outline">REG: SHA-256 SECURED</span>
</div>
</div>
<!-- Main Section Header -->
<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg">
<div class="max-w-3xl flex flex-col gap-space-xs">
<div class="flex items-center gap-2 text-primary font-label-md text-label-md uppercase tracking-wider">
<span class="material-symbols-outlined text-[18px]">terminal</span>
<span>CENTRAL DE INTELIGENCIA DE FUENTES ABIERTAS</span>
</div>
<h1 class="font-headline-xl-mobile text-headline-xl-mobile md:font-headline-xl md:text-headline-xl text-on-surface uppercase tracking-tight">INFORMES DE INTELIGENCIA &amp; ANÁLISIS ESTRATÉGICO</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant mt-1">Dossiers desclasificados, investigaciones OSINT de largo formato, desgloses audiovisuales y transcripciones técnicas procesadas con IA para indexación global y análisis predictivo.</p>
</div>
<div class="flex items-center gap-space-sm">
<button class="bg-surface-container-high hover:bg-surface-bright text-on-surface font-label-md text-label-md uppercase px-4 py-2.5 rounded transition-colors flex items-center gap-2 shadow-sm">
<span class="material-symbols-outlined text-primary text-[18px]">rss_feed</span>
<span>WIRE OSINT RSS</span>
</button>
<button class="bg-primary text-on-primary hover:bg-primary-fixed font-label-md text-label-md uppercase font-bold px-5 py-2.5 rounded transition-all shadow-[0_0_16px_rgba(16,185,129,0.3)] flex items-center gap-2">
<span class="material-symbols-outlined text-[18px]">download</span>
<span>DESCARGAS CLASIFICADAS</span>
</button>
</div>
</div>
<!-- Tactical Tabs / Category Filters -->
<div class="flex flex-wrap items-center gap-space-xs pt-space-sm overflow-x-auto">
<button class="bg-primary text-on-primary font-label-md text-label-md uppercase px-4 py-2 rounded flex items-center gap-2 font-bold shadow-sm">
<span>Oriente Medio</span>
<span class="bg-on-primary text-primary text-[10px] px-1.5 py-0.2 rounded font-label-sm">48</span>
</button>
<button class="bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-label-md text-label-md uppercase px-4 py-2 rounded flex items-center gap-2 transition-colors">
<span>Asia-Pacífico</span>
<span class="bg-surface-container-highest text-on-surface-variant text-[10px] px-1.5 py-0.2 rounded font-label-sm">34</span>
</button>
<button class="bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-label-md text-label-md uppercase px-4 py-2 rounded flex items-center gap-2 transition-colors">
<span>Reservas Militares &amp; Balística</span>
<span class="bg-surface-container-highest text-on-surface-variant text-[10px] px-1.5 py-0.2 rounded font-label-sm">29</span>
</button>
<button class="bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-label-md text-label-md uppercase px-4 py-2 rounded flex items-center gap-2 transition-colors">
<span>Occidente vs. Oriente (Geoeconomía)</span>
<span class="bg-surface-container-highest text-on-surface-variant text-[10px] px-1.5 py-0.2 rounded font-label-sm">52</span>
</button>
<button class="bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-label-md text-label-md uppercase px-4 py-2 rounded flex items-center gap-2 transition-colors">
<span>Ciberguerra &amp; Espacio</span>
<span class="bg-surface-container-highest text-on-surface-variant text-[10px] px-1.5 py-0.2 rounded font-label-sm">17</span>
</button>
</div>
<!-- Advanced Filter & Search Console -->
<div class="bg-surface-container p-space-md rounded-lg shadow-md flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-space-md">
<div class="relative flex-1">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
<input class="w-full bg-surface-container-lowest text-on-surface pl-10 pr-4 py-2.5 rounded font-label-md text-label-md focus:outline-none placeholder:text-outline shadow-inner" placeholder="Filtrar por vector, tecnología balística, coordenadas o entidad..." type="text"/>
</div>
<div class="flex flex-wrap items-center gap-space-sm">
<div class="flex items-center bg-surface-container-lowest px-3 py-1.5 rounded">
<span class="font-label-sm text-label-sm text-outline uppercase mr-2">PERIODO:</span>
<select class="bg-transparent text-on-surface font-label-sm text-label-sm focus:outline-none cursor-pointer">
<option class="bg-surface-container-lowest">Últimas 72 Horas</option>
<option class="bg-surface-container-lowest">Último Mes (30D)</option>
<option class="bg-surface-container-lowest">Trimestre Q3-Q4</option>
<option class="bg-surface-container-lowest">Archivo Histórico 2024</option>
</select>
</div>
<div class="flex items-center bg-surface-container-lowest px-3 py-1.5 rounded">
<span class="font-label-sm text-label-sm text-outline uppercase mr-2">NIVEL INTEL:</span>
<select class="bg-transparent text-on-surface font-label-sm text-label-sm focus:outline-none cursor-pointer">
<option class="bg-surface-container-lowest">Todos los Niveles</option>
<option class="bg-surface-container-lowest">Nivel 1: Flash Sitrep</option>
<option class="bg-surface-container-lowest">Nivel 2: In-Depth OSINT</option>
<option class="bg-surface-container-lowest">Nivel 3: GEOINT Dossier</option>
</select>
</div>
<div class="flex items-center bg-surface-container-lowest px-3 py-1.5 rounded">
<span class="font-label-sm text-label-sm text-outline uppercase mr-2">FORMATO:</span>
<select class="bg-transparent text-on-surface font-label-sm text-label-sm focus:outline-none cursor-pointer">
<option class="bg-surface-container-lowest">Todos (Video, Audio, Texto)</option>
<option class="bg-surface-container-lowest">Video + Transcripción IA</option>
<option class="bg-surface-container-lowest">Solo Texto Técnico</option>
<option class="bg-surface-container-lowest">Audio Broadcast / Podcast</option>
</select>
</div>
</div>
</div>
</div>
</section>
<!-- SECTION: FEATURED IN-STREAM DOSSIER (VIDEO + AI TRANSCRIPTION CASE STUDY) -->
<section class="w-full bg-background px-gutter py-space-xl">
<div class="max-w-7xl mx-auto flex flex-col gap-space-xl">
<!-- Breadcrumb & Incident Metadata Header -->
<div class="flex flex-col gap-space-sm">
<nav class="flex items-center gap-2 font-label-sm text-label-sm text-outline uppercase tracking-wider">
<a class="hover:text-primary transition-colors" href="#">Inicio</a>
<span>/</span>
<a class="hover:text-primary transition-colors" href="#">Informes</a>
<span>/</span>
<a class="hover:text-primary transition-colors" href="#">Oriente Medio</a>
<span>/</span>
<span class="text-primary font-bold">Informe SITREP-2024-09</span>
</nav>
<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-md">
<div class="max-w-4xl flex flex-col gap-space-xs">
<div class="flex flex-wrap items-center gap-2">
<span class="font-label-sm text-label-sm bg-error-container text-on-error-container px-2 py-0.5 rounded font-bold uppercase flex items-center gap-1">
<span class="w-1.5 h-1.5 rounded-full bg-error animate-ping"></span>
                CHOKEPOINT CRÍTICO
              </span>
<span class="font-label-sm text-label-sm bg-surface-container-high text-on-surface-variant px-2 py-0.5 rounded">GEOINT VECTOR ID: 12.65°N, 43.41°E</span>
<span class="font-label-sm text-label-sm bg-tertiary-container text-on-tertiary px-2 py-0.5 rounded font-bold">ALERTA NAVAL NIVEL 4</span>
</div>
<h2 class="font-headline-xl text-headline-xl text-on-surface uppercase tracking-tight mt-1 leading-tight">
              Análisis Exhaustivo: ¿Por qué la Isla de Perim define el futuro del comercio entre Asia y Europa?
            </h2>
</div>
<!-- Quick Metrics Bar -->
<div class="flex flex-wrap items-center gap-space-md bg-surface-container-low px-space-md py-2.5 rounded shrink-0">
<div class="flex flex-col">
<span class="font-label-sm text-label-sm text-outline">PUBLICADO ZULU</span>
<span class="font-label-md text-label-md text-on-surface font-bold">24-OCT-2024 11:20Z</span>
</div>
<div class="w-px h-8 bg-surface-container-highest"></div>
<div class="flex flex-col">
<span class="font-label-sm text-label-sm text-outline">TIEMPO LECTURA</span>
<span class="font-label-md text-label-md text-primary font-bold">18 MIN // AUDIO 24:15</span>
</div>
<div class="w-px h-8 bg-surface-container-highest"></div>
<div class="flex flex-col">
<span class="font-label-sm text-label-sm text-outline">CLASIFICACIÓN</span>
<span class="font-label-md text-label-md text-tertiary font-bold">OSINT PUBLIC / UNCLAS</span>
</div>
</div>
</div>
<!-- Author / Credentials Strip -->
<div class="flex flex-wrap items-center justify-between gap-space-md bg-surface-container p-space-sm rounded">
<div class="flex items-center gap-space-md">
<div class="w-10 h-10 rounded bg-surface-container-highest flex items-center justify-center text-primary font-label-md font-bold">
              OS
            </div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-on-surface leading-none">Comandante (R) Marc Segarra &amp; Equipo OSINT-Echo</span>
<span class="font-label-sm text-label-sm text-outline mt-1">Ex-Analista SIGINT OTAN // Director Técnico de Dossiers en Noticias Geopolítica</span>
</div>
</div>
<div class="flex items-center gap-space-sm">
<button class="bg-surface-container-high hover:bg-surface-bright text-on-surface text-label-sm font-label-sm uppercase px-3 py-1.5 rounded transition-colors flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px] text-primary">verified</span>
<span>VERIFICADO POR SAT-DATA</span>
</button>
<button class="bg-surface-container-high hover:bg-surface-bright text-on-surface text-label-sm font-label-sm uppercase px-3 py-1.5 rounded transition-colors flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px]">share</span>
<span>COMPARTIR</span>
</button>
</div>
</div>
</div>
<!-- TACTICAL IN-STREAM VIDEO PLAYER -->
<div class="w-full bg-surface-container-lowest rounded-xl p-space-md shadow-2xl flex flex-col gap-space-md">
<!-- Player Container (16:9 Aspect Ratio with Military Telemetry UI) -->
<div class="relative w-full aspect-video bg-surface-container-lowest rounded-lg overflow-hidden flex items-center justify-center group shadow-xl">
<!-- Video Thumbnail Image -->
<img class="w-full h-full object-cover opacity-75 group-hover:opacity-60 transition-opacity" data-alt="Satellite imagery and military tactical view of the Perim Island in the Bab-el-Mandeb strait with radar circles, naval routes, vector lines in neon green and amber, cinematic dark defense atmosphere." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCU226KW9QAyadU70orWKCvzvNOMdBj0Z8z1GGVrPo5v1UiHCoAZLS3neZG25Zaf79woYJkkCfToIzNHdk8z3A6yIHsPH0NGWrWXdSMpWkV0912TrdirlIvCkTo-AA6bzdmLFSbF-xgIUPUUHxOgz1gnDW6I36Q_wij3yaHc5DNMQ10epeZMhGFJIofp1N7bb5BbGlTkYp5Gy5HewXbYEOGUs-LCcu-I4G7R0AlWr_eBRR_7y8CSLMxQQ"/>
<!-- Tactical HUD Reticle & Crosshair Overlays -->
<div class="absolute inset-0 pointer-events-none p-space-md flex flex-col justify-between">
<div class="flex items-center justify-between text-primary font-label-sm text-label-sm">
<div class="bg-surface-container-lowest/80 px-2 py-1 rounded backdrop-blur-sm flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-error animate-ping"></span>
<span>REC // STREAM SYNC: BAB-EL-MANDEB SECTOR 4</span>
</div>
<div class="bg-surface-container-lowest/80 px-2 py-1 rounded backdrop-blur-sm">
<span>GEO-LOC: 12°39'24"N 43°24'54"E</span>
</div>
</div>
<div class="flex items-center justify-between text-outline font-label-sm text-label-sm">
<div class="bg-surface-container-lowest/80 px-2 py-1 rounded backdrop-blur-sm">
<span>FPS: 60.00 // BITRATE: 14.8 MBPS // H.265</span>
</div>
<div class="bg-surface-container-lowest/80 px-2 py-1 rounded backdrop-blur-sm text-primary">
<span>OPTICAL SENSOR: FLIR-SAT MK IX</span>
</div>
</div>
</div>
<!-- Play Button (Big Tactical Trigger) -->
<button class="absolute z-10 w-20 h-20 rounded-full bg-primary/90 text-on-primary hover:bg-primary-fixed flex items-center justify-center shadow-[0_0_30px_rgba(16,185,129,0.5)] transition-transform hover:scale-110 active:scale-95">
<span class="material-symbols-outlined text-[42px] ml-1">play_arrow</span>
</button>
<!-- Bottom Control Bar (In-Stream Simulation) -->
<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/90 to-transparent p-space-md flex flex-col gap-2 z-20">
<!-- Timeline / Chapters -->
<div class="relative w-full h-2 bg-surface-container-highest rounded-full cursor-pointer overflow-hidden">
<div class="h-full bg-primary rounded-full w-[38%]"></div>
<!-- Chapter markers -->
<div class="absolute top-0 bottom-0 left-[18%] w-0.5 bg-on-surface/60" title="04:30 Imágenes Satélite"></div>
<div class="absolute top-0 bottom-0 left-[46%] w-0.5 bg-on-surface/60" title="11:15 Capacidades Antibuque"></div>
<div class="absolute top-0 bottom-0 left-[77%] w-0.5 bg-on-surface/60" title="18:40 Impacto Brent"></div>
</div>
<!-- Controls row -->
<div class="flex items-center justify-between text-on-surface font-label-md text-label-md">
<div class="flex items-center gap-space-md">
<button class="hover:text-primary transition-colors flex items-center">
<span class="material-symbols-outlined text-[24px]">play_arrow</span>
</button>
<button class="hover:text-primary transition-colors flex items-center">
<span class="material-symbols-outlined text-[20px]">volume_up</span>
</button>
<span class="font-label-sm text-label-sm text-on-surface-variant">09:12 / 24:15</span>
</div>
<!-- Chapter current title -->
<div class="hidden md:flex items-center gap-2 font-label-sm text-label-sm bg-surface-container-low/90 px-3 py-1 rounded">
<span class="text-tertiary font-bold">CAPÍTULO 2:</span>
<span class="text-on-surface">Imágenes de satélite de la pista de aterrizaje construida en Perim</span>
</div>
<div class="flex items-center gap-space-sm">
<span class="bg-surface-container-high px-2 py-0.5 rounded text-primary text-[10px] font-bold">1080p 60HD</span>
<button class="hover:text-primary font-label-sm text-label-sm px-1.5 py-0.5 rounded hover:bg-surface-container-high">1.25x</button>
<button class="hover:text-primary font-label-sm text-label-sm px-1.5 py-0.5 rounded hover:bg-surface-container-high">1.5x</button>
<button class="hover:text-primary transition-colors flex items-center ml-2">
<span class="material-symbols-outlined text-[20px]">fullscreen</span>
</button>
</div>
</div>
</div>
</div>
<!-- Video Channel Social Sync / Conversion Actions -->
<div class="flex flex-wrap items-center justify-between gap-space-md bg-surface-container p-space-sm rounded-lg">
<div class="flex items-center gap-space-md">
<div class="flex items-center gap-2">
<span class="font-label-sm text-label-sm text-outline">ORIGEN DEL TRANSMISOR:</span>
<span class="font-label-sm text-label-sm text-primary font-bold">CANAL OFICIAL NOTICIAS GEOPOLÍTICA</span>
</div>
<span class="text-outline">|</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">142K VISUALIZACIONES MULTIPLATAFORMA</span>
</div>
<div class="flex flex-wrap items-center gap-space-sm">
<!-- YouTube CTA -->
<a class="bg-error hover:bg-error-container text-on-error hover:text-on-error-container font-label-sm text-label-sm uppercase px-4 py-2 rounded flex items-center gap-2 font-bold transition-colors shadow-sm" href="#">
<span class="material-symbols-outlined text-[16px]">smart_display</span>
<span>SUSCRIBIRSE EN YOUTUBE</span>
</a>
<!-- Facebook Watch CTA -->
<a class="bg-secondary-container hover:bg-secondary text-on-secondary-container hover:text-on-secondary font-label-sm text-label-sm uppercase px-4 py-2 rounded flex items-center gap-2 font-bold transition-colors shadow-sm" href="#">
<span class="material-symbols-outlined text-[16px]">thumb_up</span>
<span>SEGUIR EN FACEBOOK</span>
</a>
<button class="bg-surface-container-high hover:bg-surface-bright text-on-surface font-label-sm text-label-sm uppercase px-3 py-2 rounded flex items-center gap-1.5 transition-colors">
