<!-- Transcription Feed (8 cols) -->
<div class="lg:col-span-8 flex flex-col gap-space-md">
<!-- In-Transcript Keyword Filter -->
<div class="flex items-center justify-between bg-surface-container-lowest px-space-md py-2.5 rounded shadow-inner">
