---
import TopNavLayout from '../layouts/TopNavLayout.astro';
---

<TopNavLayout>
  <div class="flex flex-col w-full">
    <section class="w-full bg-surface-container-lowest px-gutter py-space-xl">
      <div class="max-w-7xl mx-auto flex flex-col gap-space-lg">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg">
          <div class="max-w-3xl flex flex-col gap-space-xs">
            <div class="flex items-center gap-2 text-primary font-label-md text-label-md uppercase tracking-wider">
              <span class="material-symbols-outlined text-[18px]">terminal</span>
              <span>CENTRAL DE INTELIGENCIA DE FUENTES ABIERTAS</span>
            </div>
            <h1 class="font-headline-xl text-headline-xl text-on-surface uppercase tracking-tight">INFORMES DE INTELIGENCIA & ANÁLISIS ESTRATÉGICO</h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant mt-1">Dossiers desclasificados, investigaciones OSINT de largo formato, desgloses audiovisuales y transcripciones técnicas procesadas con IA para indexación global y análisis predictivo.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</TopNavLayout>
